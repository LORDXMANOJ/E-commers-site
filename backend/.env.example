# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS allow-list)
CLIENT_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────
# Local: `npm run db:local` starts PostgreSQL on 5433 with these credentials.
# Production: paste your Neon / Supabase connection string.
# If port 5433 is busy, set LOCAL_PG_PORT and change the port in both URLs below.
LOCAL_PG_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aurelle
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aurelle_test

# ── Auth ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# Comma-separated emails that are promoted to ADMIN on register/login
ADMIN_EMAILS=

# ── Email (optional) ────────────────────────────────────
# Without a key, password-reset links are returned in the API response in development only.
RESEND_API_KEY=
EMAIL_FROM=Aurelle <onboarding@resend.dev>
